    startdate: "9/25",
    enddate: "Present",
    title: "Software Engineer",
    projects: [
        "Designed and implemented a consumer and business prefill platform end-to-end, integrating ranking, exclusion, and identity deduplication services into a multi-step waterfall pipeline.",
        "Built configurable identity verification workflows including PO Box validation, national ID normalization, deceased-record filtering, and name-match scoring with tunable thresholds.",
        "Improved service observability and reliability through OpenTelemetry health checks, enriched decision-point logging, and correlation-ID tracing across services.",
        "Built sandbox environments for prefill flows, enabling integration testing without dependencies on production data.",
        "Maintained CI/CD pipelines across multiple services and resolved security scan failures.",
        "Updated OpenAPI specifications and API schemas to support new product fields, identity attributes, and response structures.",
    ],
}

ExperienceEntry {
    name: "PDQ",
    startdate: "4/24",
    enddate: "8/25",
    title: "Application Security Engineer",
    projects: [
        "Developed application security capabilities including threat modeling, SAST/DAST, application penetration testing, and fuzzing.",
        "Performed security assessments of applications and services and worked with engineering teams to remediate vulnerabilities.",
        "Built and automated security testing capabilities to improve the breadth and repeatability of application security assessments.",
    ],
}

ExperienceEntry {
    name: "VMware",
    startdate: "10/19",
    enddate: "1/24",
    title: "Senior Threat Researcher",
    projects: [
        //"Engineered pipeline of scan creation for 100k+ assets to facilitate vulnerability management.  Automated collection of asset and ownership data, data normalization, and asset and scan creation.",
        "Developed a malware classification system based on opcode-sequence frequency analysis, enabling automated comparison and clustering of malware samples and classification of new samples into known malware families.",
        "Developed an automated UPX unpacker capable of recovering executable metadata and unpacking stripped, packed binaries.",
        "Co-developed an in-house PowerShell deobfuscator, including components for lexical analysis, parsing, and evaluation.",
        "Co-developed Binee (Binary Emulation Environment), an open-source PE emulator that modeled substantial portions of the Windows environment, including threading, scheduling, the registry, filesystem, and userland process structures.",
        "Built analysis infrastructure capable of extracting behavioral data from malware at scale for use in machine-learning-based malware detection.",
        "Developed team tools for running analysis pipelines on binary executable samples.",
    ],

}

